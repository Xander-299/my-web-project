<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
  <mapper namespace="com.tlias.mapper.LoginMapper">
    <select id="loginSystem" resultType="com.tlias.pojo.Emp">

        SELECT e.id,e.username,e.name from tlias.emp AS e 
        where 
        (e.username,e.password) = (#{username},#{password})
    </select>
  </mapper>